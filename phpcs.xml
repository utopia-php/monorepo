<?xml version="1.0"?>
<ruleset name="Utopia Complexity">
    <description>Reject production methods and functions with a cognitive complexity above 20.</description>

    <arg name="extensions" value="php"/>

    <rule ref="SlevomatCodingStandard.Complexity.Cognitive">
        <properties>
            <property name="warningThreshold" value="21"/>
            <property name="errorThreshold" value="21"/>
        </properties>
    </rule>
</ruleset>
