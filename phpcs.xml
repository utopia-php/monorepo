<?xml version="1.0"?>
<ruleset name="Utopia Complexity">
    <description>Reject production methods and functions with a cyclomatic complexity above 10.</description>

    <arg name="extensions" value="php"/>

    <rule ref="Generic.Metrics.CyclomaticComplexity">
        <properties>
            <property name="complexity" value="10"/>
            <property name="absoluteComplexity" value="10"/>
        </properties>
    </rule>
</ruleset>
