<?xml version="1.0"?>
<ruleset name="Utopia Complexity">
    <description>Reject production methods and functions with a cyclomatic complexity above 20.</description>

    <arg name="extensions" value="php"/>

    <rule ref="Generic.Metrics.CyclomaticComplexity">
        <properties>
            <property name="complexity" value="20"/>
            <property name="absoluteComplexity" value="20"/>
        </properties>
    </rule>
</ruleset>
