{
    "name": "utopia-php/monorepo",
    "description": "Monorepo for the utopia-php ecosystem",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": ">=8.4"
    },
    "require-dev": {
        "laravel/pint": "^1.24",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^12",
        "rector/rector": "^2.4",
        "slevomat/coding-standard": "^8.31",
        "squizlabs/php_codesniffer": "^4.0"
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    }
}
