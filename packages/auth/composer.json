{
    "name": "utopia-php/auth",
    "description": "A simple PHP authentication library",
    "type": "library",
    "keywords": [
        "php",
        "auth",
        "authentication",
        "security"
    ],
    "license": "MIT",
    "minimum-stability": "stable",
    "authors": [
        {
            "name": "Utopia PHP",
            "email": "team@appwrite.io"
        }
    ],
    "autoload": {
        "psr-4": {
            "Utopia\\Auth\\": "src/Auth"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Utopia\\Tests\\Auth\\": "tests/Auth",
            "Utopia\\Tests\\Auth\\E2E\\": "tests/E2E"
        }
    },
    "scripts": {
        "test": "phpunit --configuration phpunit.xml --testsuite unit",
        "test:e2e": "phpunit --configuration phpunit.xml --testsuite e2e"
    },
    "require": {
        "php": ">=8.3",
        "ext-curl": "*",
        "ext-hash": "*",
        "ext-json": "*",
        "ext-openssl": "*",
        "ext-scrypt": "*",
        "ext-sodium": "*",
        "utopia-php/validators": "^0.5"
    }
}
